<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.abood8001</groupId>
    <artifactId>MobTag</artifactId>
    <version>2.2.0-tw3</version>
    <packaging>jar</packaging>

    <name>MobTag</name>
    <description>Display mob health tags above mobs with full customization.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Spigot -->
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- PlaceholderAPI -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <!-- MythicMobs -->
        <repository>
            <id>lumine-repo</id>
            <url>https://mvn.lumine.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>bstats-repo</id>
            <url>https://repo.bstats.org/repository/releases/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>26.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.lumine</groupId>
            <artifactId>Mythic-Dist</artifactId>
            <version>5.6.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
            Compile-only. MiniMessage is never shaded: MobTag resolves it at runtime and silently
            falls back to legacy colour codes on servers that do not ship Adventure.
        -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>me.abood8001.mobtag.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <!--
                Only plugin.yml needs ${project.version} substituted. Filtering config.yml as well
                used to run the box-drawing and heart glyphs through the resource filter for no
                reason, which is a well known way to corrupt them on a non-UTF-8 platform.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <profiles>
        <!--
            Optional release obfuscation:  mvn clean package -Pobfuscate
            Renaming only - shrinking and optimisation are disabled on purpose, because a Bukkit
            plugin reaches a lot of code reflectively and a removed method fails at runtime rather
            than at build time.
        -->
        <profile>
            <id>obfuscate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>2.7.0</version>
                        <executions>
                            <execution>
                                <id>obfuscate-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <injar>${project.build.finalName}.jar</injar>
                            <outjar>${project.build.finalName}.jar</outjar>
                            <obfuscate>true</obfuscate>
                            <attach>false</attach>
                            <!--
                                No JDK libraryjar on purpose. ProGuard cannot read a newer JDK's
                                java.base.jmod than it was built for, and renaming-only mode does
                                not need the platform class hierarchy. Override -Dmobtag.jdk.lib
                                if a future ProGuard version wants it back.
                            -->
                            <options>
                                <option>-dontshrink</option>
                                <option>-dontoptimize</option>
                                <option>-dontnote</option>
                                <option>-dontwarn</option>
                                <option>-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,Exceptions</option>
                                <!-- plugin.yml names this class, so it must keep its identity. -->
                                <option>-keep public class me.abood8001.mobtag.MobTag { *; }</option>
                                <!-- bStats resolves parts of itself reflectively. -->
                                <option>-keep class me.abood8001.mobtag.bstats.** { *; }</option>
                                <!-- Bukkit reflects over annotated handlers to register them. -->
                                <option>-keepclassmembers class * implements org.bukkit.event.Listener {
                                    @org.bukkit.event.EventHandler &lt;methods&gt;;
                                    }</option>
                                <!-- PlaceholderAPI calls into the expansion by contract. -->
                                <option>-keep class * extends me.clip.placeholderapi.expansion.PlaceholderExpansion { *; }</option>
                                <option>-keepclassmembers enum * {
                                    public static **[] values();
                                    public static ** valueOf(java.lang.String);
                                    }</option>
                            </options>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>com.guardsquare</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>7.8.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
